@startuml questao2
title Questao 2 - Casa de Leiloes Online\nObserver (RNF01) + Strategy (RNF02) + Decorator (RNF03, RNF04)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<Subject>> #DCEBFF
  BackgroundColor<<Observer>> #DCEBFF
  BackgroundColor<<ConcreteObserver>> #EEF5FF
  BackgroundColor<<Strategy>> #E3F6E3
  BackgroundColor<<ConcreteStrategy>> #F2FBF2
  BackgroundColor<<Component>> #F8E1F4
  BackgroundColor<<ConcreteComponent>> #FCF0FA
  BackgroundColor<<Decorator>> #F8E1F4
  BackgroundColor<<ConcreteDecorator>> #FCF0FA
}

package leilao {
  class Lote <<ConcreteSubject>> <<Context>> #EEF5FF {
    - {static} FATOR_LANCE_MINIMO : BigDecimal = 1,05
    - nome : String
    - precoInicial : BigDecimal
    - precoReserva : BigDecimal
    - observadores : List<ObservadorLance>
    - lances : List<Lance>
    - regraComissao : RegraComissao
    - situacao : SituacaoLote
    - comissaoCobrada : BigDecimal
    + Lote(nome, categoria, precoInicial, precoReserva)
    + adicionarObservador(o : ObservadorLance) : void
    + removerObservador(o : ObservadorLance) : void
    + notificarObservadores(lance : Lance) : void
    + receberLance(licitante : Licitante, valor : BigDecimal) : boolean
    + getLanceAtual() : BigDecimal
    + getMaiorLance() : Lance
    + getTotalLances() : int
    + trocarRegraComissao(novaRegra : RegraComissao) : void
    + encerrar() : void
    + getComprador() : Licitante
    + getValorVenda() : BigDecimal
    + getComissaoCobrada() : BigDecimal
  }
  interface Licitante {
    + getNome() : String
  }
  class Lance <<final>> {
    - valor : BigDecimal
    - dataHora : LocalDateTime
    + getLicitante() : Licitante
  }
  class Categoria <<final>> {
    - nome : String
    + getRegraPadrao() : RegraComissao
  }
  enum SituacaoLote {
    ABERTO
    VENDIDO
    NAO_VENDIDO
  }
}

package acompanhamento {
  interface Sujeito <<Subject>> {
    + adicionarObservador(o : ObservadorLance) : void
    + removerObservador(o : ObservadorLance) : void
    + notificarObservadores(lance : Lance) : void
  }
  interface ObservadorLance <<Observer>> {
    + atualizar(lote : Lote, lance : Lance) : void
  }
  class Participante <<ConcreteObserver>> {
    - nome : String
    + acompanhar(lote : Lote) : void
    + deixarDeAcompanhar(lote : Lote) : void
    + darLance(lote : Lote, valor : BigDecimal) : boolean
    + atualizar(lote : Lote, lance : Lance) : void
  }
  class PainelLeiloeiro <<ConcreteObserver>> {
    + atualizar(lote : Lote, lance : Lance) : void
  }
  class AuditorLances <<ConcreteObserver>> {
    - registros : List<String>
    + atualizar(lote : Lote, lance : Lance) : void
    + imprimirRegistros() : void
  }
}

package comissao {
  interface RegraComissao <<Strategy>> {
    + calcular(valorVenda : BigDecimal) : BigDecimal
    + getDescricao() : String
  }
  class ComissaoArte <<ConcreteStrategy>> {
    20% do valor
  }
  class ComissaoVeiculos <<ConcreteStrategy>> {
    8% do valor, teto R$ 5.000,00
  }
  class ComissaoImoveis <<ConcreteStrategy>> {
    3% do valor + R$ 1.500,00
  }
  class ComissaoEletronicos <<ConcreteStrategy>> {
    12% do valor, minimo R$ 50,00
  }
}

package servicos {
  interface Compra <<Component>> {
    + getNomeLote() : String
    + getComprador() : String
    + getValorVenda() : BigDecimal
    + getServicos() : List<ItemFatura>
    + getTotal() : BigDecimal
  }
  class CompraLote <<ConcreteComponent>> {
    - nomeLote : String
    - comprador : String
    - valorVenda : BigDecimal
    + CompraLote(lote : Lote)
  }
  abstract class ServicoAdicional <<Decorator>> {
    # compra : Compra
    # ServicoAdicional(compra : Compra)
    + getServicos() : List<ItemFatura>
    + getTotal() : BigDecimal
  }
  class SeguroTransporte <<ConcreteDecorator>> {
    1,5% do valor de venda
    + getServicos() : List<ItemFatura>
    + getTotal() : BigDecimal
  }
  class CertificadoAutenticidade <<ConcreteDecorator>> {
    R$ 300,00
    + getServicos() : List<ItemFatura>
    + getTotal() : BigDecimal
  }
  class EmbalagemEspecial <<ConcreteDecorator>> {
    R$ 180,00
    + getServicos() : List<ItemFatura>
    + getTotal() : BigDecimal
  }
  class EntregaExpressa <<ConcreteDecorator>> {
    R$ 450,00
    + getServicos() : List<ItemFatura>
    + getTotal() : BigDecimal
  }
  class ItemFatura <<final>> {
    - descricao : String
    - custo : BigDecimal
  }
}

package relatorios {
  class ImpressoraFatura {
    + imprimir(compra : Compra) : void
  }
  class AcertoVendedor {
    + imprimir(lote : Lote) : void
  }
}

package util {
  class Moeda <<final>> {
    + {static} formatar(valor : BigDecimal) : String
  }
}

class Main {
  + {static} main(args : String[]) : void
}

' ---------------- Observer ----------------
Sujeito <|.. Lote
ObservadorLance <|.. Participante
ObservadorLance <|.. PainelLeiloeiro
ObservadorLance <|.. AuditorLances
Licitante <|.. Participante
Lote o--> "0..*" ObservadorLance : observadores
Sujeito ..> ObservadorLance : notifica
Lote *--> "0..*" Lance : lances
Lance --> "1" Licitante : licitante
Participante ..> Lote : acompanha / da lance

' ---------------- Strategy ----------------
Lote --> "1" Categoria : categoria
Lote --> "1" SituacaoLote
Lote o--> "1" RegraComissao : regraComissao (trocavel)
Categoria --> "1" RegraComissao : regraPadrao
RegraComissao <|.. ComissaoArte
RegraComissao <|.. ComissaoVeiculos
RegraComissao <|.. ComissaoImoveis
RegraComissao <|.. ComissaoEletronicos

' ---------------- Decorator ----------------
Compra <|.. CompraLote
Compra <|.. ServicoAdicional
ServicoAdicional o--> "1" Compra : compra (envolve)
ServicoAdicional <|-- SeguroTransporte
ServicoAdicional <|-- CertificadoAutenticidade
ServicoAdicional <|-- EmbalagemEspecial
ServicoAdicional <|-- EntregaExpressa
Compra ..> ItemFatura
CompraLote ..> Lote : le venda

' ---------------- Relatorios / Main ----------------
ImpressoraFatura ..> Compra
AcertoVendedor ..> Lote
ImpressoraFatura ..> Moeda
AcertoVendedor ..> Moeda
Lote ..> Moeda
Main ..> Lote : <<create>>
Main ..> Categoria : <<create>>
Main ..> Participante : <<create>>
Main ..> PainelLeiloeiro : <<create>>
Main ..> AuditorLances : <<create>>
Main ..> RegraComissao : <<create>> estrategias
Main ..> Compra : <<create>> decoradores
Main ..> ImpressoraFatura
Main ..> AcertoVendedor

note top of Sujeito
  <b>Observer</b>: o Lote so conhece ObservadorLance
  e Licitante. Cada lance aceito e enviado a todos
  os observadores, menos a quem deu o lance.
  Novo interessado = nova classe (RNF01).
end note

note top of RegraComissao
  <b>Strategy</b>: nenhuma classe faz if/switch pela
  categoria. trocarRegraComissao() muda a regra em
  tempo de execucao, antes do encerramento (RNF02/RF07).
end note

note top of Compra
  <b>Decorator</b>: cada servico envolve uma Compra
  e soma a sua linha e o seu custo. Qualquer
  combinacao, ordem e quantidade, sem classes
  de combinacao (RNF03). ImpressoraFatura trata
  qualquer Compra igual (RNF04).
end note
@enduml
